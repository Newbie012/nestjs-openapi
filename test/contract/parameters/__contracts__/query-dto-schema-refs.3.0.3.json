{
  "openapi": "3.0.3",
  "info": {
    "description": "Tests query DTO schema ref behavior - DTOs should be kept as single parameters with $ref",
    "title": "Query DTO Schema Refs Test API",
    "version": "1.0.0"
  },
  "servers": [],
  "paths": {
    "/items": {
      "get": {
        "operationId": "ItemsController_findAll",
        "parameters": [
          {
            "in": "query",
            "name": "_pagination",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PaginationQueryDto"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Get items with pagination (DTO inlined)",
        "tags": [
          "Items"
        ]
      }
    },
    "/items/combined": {
      "get": {
        "operationId": "ItemsController_combined",
        "parameters": [
          {
            "in": "query",
            "name": "_query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CombinedQueryDto"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Combined query params",
        "tags": [
          "Items"
        ]
      }
    },
    "/items/named": {
      "get": {
        "operationId": "ItemsController_namedFilter",
        "parameters": [
          {
            "description": "Filter object as JSON",
            "in": "query",
            "name": "filter",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FilterQueryDto"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Named query param (not inlined)",
        "tags": [
          "Items"
        ]
      }
    },
    "/items/primitive": {
      "get": {
        "operationId": "ItemsController_primitiveParams",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "active",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Primitive query params",
        "tags": [
          "Items"
        ]
      }
    },
    "/items/search": {
      "get": {
        "operationId": "ItemsController_search",
        "parameters": [
          {
            "in": "query",
            "name": "_filter",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FilterQueryDto"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Search items with filters (DTO inlined)",
        "tags": [
          "Items"
        ]
      }
    },
    "/items/validated": {
      "get": {
        "operationId": "ItemsController_validatedSearch",
        "parameters": [
          {
            "in": "query",
            "name": "_query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ValidatedQueryDto"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Search with validated query params",
        "tags": [
          "Items"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CombinedQueryDto": {
        "description": "Combined query params DTO",
        "properties": {
          "includeDeleted": {
            "type": "boolean"
          },
          "limit": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "search": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "FilterQueryDto": {
        "description": "Filter DTO with required and optional fields",
        "properties": {
          "category": {
            "description": "Optional category filter",
            "type": "string"
          },
          "dateFrom": {
            "description": "Optional date range",
            "type": "string"
          },
          "dateTo": {
            "type": "string"
          },
          "search": {
            "description": "Required search term",
            "type": "string"
          },
          "status": {
            "description": "Optional status filter",
            "enum": [
              "active",
              "inactive",
              "pending"
            ],
            "type": "string"
          }
        },
        "required": [
          "search"
        ],
        "type": "object"
      },
      "PaginationQueryDto": {
        "description": "Pagination DTO for testing query param inlining",
        "properties": {
          "limit": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "sortBy": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SortOrder": {
        "description": "Sort order enum for testing enum validation",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "ValidatedQueryDto": {
        "description": "DTO with validation decorators - tests that",
        "properties": {
          "limit": {
            "description": "Optional via both",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "page": {
            "description": "Optional via",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "search": {
            "description": "Required search term (no",
            "minLength": 1,
            "type": "string"
          },
          "sortOrder": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SortOrder"
              }
            ],
            "description": "Enum with"
          }
        },
        "required": [
          "search"
        ],
        "type": "object"
      }
    }
  },
  "tags": []
}
