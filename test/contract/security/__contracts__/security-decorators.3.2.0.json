        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "OAuthController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of projects"
          }
        },
        "security": [
          {
            "oauth2": [
              "read:projects"
            ]
          }
        ],
        "summary": "List all projects",
        "tags": [
          "Projects"
        ]
      },
      "post": {
        "operationId": "OAuthController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDto"
                }
              }
            },
            "description": "Project created"
          }
        },
        "security": [
          {
            "oauth2": [
              "read:projects",
              "write:projects"
            ]
          }
        ],
        "summary": "Create project (requires write scope)",
        "tags": [
          "Projects"
        ]
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "OAuthController_findOne",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDto"
                }
              }
            },
            "description": "Project found"
          }
        },
        "security": [
          {
            "oauth2": [
              "read:projects"
            ]
          }
        ],
        "summary": "Get project by ID",
        "tags": [
          "Projects"
        ]
      },
      "put": {
        "operationId": "OAuthController_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDto"
                }
              }
            },
            "description": "Project updated"
          }
        },
        "security": [
          {
            "oauth2": [
              "write:projects"
            ]
          }
        ],
        "summary": "Update project",
        "tags": [
          "Projects"
        ]
      },
      "delete": {
        "operationId": "OAuthController_delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Project deleted"
          }
        },
        "security": [
          {
            "oauth2": [
              "delete:projects"
            ]
          }
        ],
        "summary": "Delete project (requires delete scope)",
        "tags": [
          "Projects"
        ]
      }
    },
    "/admin/actions": {
      "get": {
        "operationId": "MultiSchemeController_listActions",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminActionDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of admin actions"
          }
        },
        "security": [
          {
            "admin-key": [],
            "jwt": []
          }
        ],
        "summary": "List admin actions (requires JWT AND admin key)",
        "tags": [
          "Admin"
        ]
      },
      "post": {
        "operationId": "MultiSchemeController_performAction",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PerformActionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminActionDto"
                }
              }
            },
            "description": "Action performed"
          }
        },
        "security": [
          {
            "admin-key": [],
            "jwt": []
          }
        ],
        "summary": "Perform admin action",
        "tags": [
          "Admin"
        ]
      }
    },
    "/admin/public-stats": {
      "get": {
        "operationId": "MultiSchemeController_publicStats",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalActions": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "totalActions"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Statistics"
          }
        },
        "security": [
          {
            "stats-key": []
          }
        ],
        "summary": "Get public stats (only requires stats key)",
        "tags": [
          "Admin"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthDto": {
        "description": "Response for health check",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "type": "object"
      },
      "UserDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ],
        "type": "object"
      },
      "CreateUserDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object"
      },
      "ArticleDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "authorId"
        ],
        "type": "object"
      },
      "CreateArticleDto": {
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "type": "object"
      },
      "ProjectDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "ownerId"
        ],
        "type": "object"
      },
      "CreateProjectDto": {
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "type": "object"
      },
      "AdminActionDto": {
        "properties": {
          "action": {
            "type": "string"
          },
          "performedBy": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "performedBy",
          "timestamp"
        ],
        "type": "object"
      },
      "PerformActionDto": {
        "properties": {
          "action": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "admin-key": {
        "description": "Admin API key",
        "in": "header",
        "name": "X-Admin-Key",
        "type": "apiKey"
      },
      "basic": {
        "description": "HTTP Basic authentication",
        "scheme": "basic",
        "type": "http"
      },
      "bearer": {
        "bearerFormat": "JWT",
        "description": "Default JWT Bearer token",
        "scheme": "bearer",
        "type": "http"
      },
      "cookie": {
        "description": "Session cookie",
        "in": "cookie",
        "name": "session",
        "type": "apiKey"
      },
      "jwt": {
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication",
        "scheme": "bearer",
        "type": "http"
      },
      "oauth2": {
        "description": "OAuth2 authentication",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "delete:projects": "Delete projects",
              "read:projects": "Read project data",
              "write:projects": "Create and update projects"
            },
            "tokenUrl": "https://example.com/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "stats-key": {
        "description": "Stats API key",
        "in": "header",
        "name": "X-Stats-Key",
        "type": "apiKey"
      }
    }
  },
  "tags": []
}
