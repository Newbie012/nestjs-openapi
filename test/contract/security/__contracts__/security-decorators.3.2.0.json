          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Health check endpoint (no auth required)",
        "tags": [
          "Public"
        ]
      }
    },
    "/public/version": {
      "get": {
