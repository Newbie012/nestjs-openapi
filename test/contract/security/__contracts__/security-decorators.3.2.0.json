                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ArticleDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of articles"
          }
        },
        "summary": "List published articles (public)",
        "tags": [
          "Articles"
        ]
      },
      "post": {
        "operationId": "MixedController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateArticleDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDto"
                }
              }
            },
            "description": "Article created"
          }
        },
        "security": [
          {
            "basic": []
          }
        ],
        "summary": "Create article (requires basic auth)",
        "tags": [
          "Articles"
        ]
      }
    },
    "/articles/{id}": {
      "get": {
        "operationId": "MixedController_findOne",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDto"
                }
              }
            },
            "description": "Article found"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "Get article by ID (requires JWT)",
        "tags": [
          "Articles"
        ]
      },
      "delete": {
        "operationId": "MixedController_delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Article deleted"
          }
        },
        "security": [
          {
            "admin-key": []
          }
        ],
        "summary": "Delete article (requires admin API key)",
        "tags": [
          "Articles"
        ]
      }
    },
    "/articles/{id}/preview": {
      "get": {
        "operationId": "MixedController_preview",
