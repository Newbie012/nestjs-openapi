              "application/json": {
                "schema": {
                  "properties": {
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "version"
                  ],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Get API version",
        "tags": [
          "Public"
        ]
      }
    },
    "/users": {
