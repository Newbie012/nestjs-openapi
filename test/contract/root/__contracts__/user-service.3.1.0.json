{
  "openapi": "3.1.0",
  "info": {
    "title": "user-service",
    "version": "1.0.0"
  },
  "servers": [],
  "paths": {
    "/users": {
      "get": {
        "description": "Retrieve a list of users with optional filtering by role and active status",
        "operationId": "UserController_findAll",
        "parameters": [
          {
            "description": "Filter users by role",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "enum": [
                "admin",
                "user",
                "moderator"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter users by active status",
            "in": "query",
            "name": "isActive",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of users"
          }
        },
        "summary": "Get all users",
        "tags": [
          "users"
        ]
      },
      "post": {
        "description": "Create a new user account in the system",
        "operationId": "UserController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          },
          "description": "User creation data",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            },
            "description": "User created successfully"
          },
          "400": {
            "description": "Invalid user data provided"
          }
        },
        "summary": "Create new user",
        "tags": [
          "users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "description": "Retrieve a specific user by their unique identifier",
        "operationId": "UserController_findOne",
        "parameters": [
          {
            "description": "User unique identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "usr_123456789",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            },
            "description": "User details"
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "Get user by ID",
        "tags": [
          "users"
        ]
      },
      "put": {
        "description": "Update an existing user's information",
        "operationId": "UserController_update",
        "parameters": [
          {
            "description": "User unique identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "usr_123456789",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          },
          "description": "User update data",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            },
            "description": "User updated successfully"
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "Update user",
        "tags": [
          "users"
        ]
      },
      "delete": {
        "description": "Remove a user from the system",
        "operationId": "UserController_remove",
        "parameters": [
          {
            "description": "User unique identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "usr_123456789",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted successfully"
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "Delete user",
        "tags": [
          "users"
        ]
      }
    },
    "/users/{id}/profile": {
      "get": {
        "description": "Retrieve complete user profile including preferences and last login",
        "operationId": "UserController_getProfile",
        "parameters": [
          {
            "description": "User unique identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "usr_123456789",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            },
            "description": "User profile with preferences"
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "Get user profile",
        "tags": [
          "users"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserDto": {
        "properties": {
          "id": {
            "description": "Unique user identifier",
            "example": "usr_123456789",
            "type": "string"
          },
          "email": {
            "description": "User email address",
            "example": "john.doe@example.com",
            "type": "string"
          },
          "firstName": {
            "description": "User first name",
            "example": "John",
            "type": "string"
          },
          "lastName": {
            "description": "User last name",
            "example": "Doe",
            "type": "string"
          },
          "fullName": {
            "description": "Full display name",
            "example": "John Doe",
            "type": "string"
          },
          "role": {
            "description": "User role in the system",
            "enum": [
              "admin",
              "user",
              "moderator"
            ],
            "example": "user",
            "type": "string"
          },
          "isActive": {
            "description": "Whether the user account is active",
            "example": true,
            "type": "boolean"
          },
          "createdAt": {
            "description": "Account creation timestamp",
            "example": "2025-09-18T10:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "description": "Last account update timestamp",
            "example": "2025-09-18T10:00:00Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "fullName",
          "role",
          "isActive",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "CreateUserDto": {
        "properties": {
          "email": {
            "description": "User email address",
            "example": "john.doe@example.com",
            "type": "string"
          },
          "firstName": {
            "description": "User first name",
            "example": "John",
            "type": "string"
          },
          "lastName": {
            "description": "User last name",
            "example": "Doe",
            "type": "string"
          },
          "role": {
            "default": "user",
            "description": "User role in the system",
            "enum": [
              "admin",
              "user",
              "moderator"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName",
          "role"
        ],
        "type": "object"
      },
      "UpdateUserDto": {
        "properties": {
          "firstName": {
            "description": "User first name",
            "type": "string"
          },
          "lastName": {
            "description": "User last name",
            "type": "string"
          },
          "role": {
            "description": "User role in the system",
            "enum": [
              "admin",
              "user",
              "moderator"
            ],
            "type": "string"
          },
          "isActive": {
            "description": "Whether the user account is active",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "UserProfileDto": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto",
            "description": "User information"
          },
          "preferences": {
            "description": "User preferences",
            "example": {
              "notifications": true,
              "theme": "dark"
            },
            "type": "object"
          },
          "lastLogin": {
            "description": "Last login timestamp",
            "example": "2025-09-18T14:30:00Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "user",
          "preferences",
          "lastLogin"
        ],
        "type": "object"
      }
    }
  },
  "tags": []
}
