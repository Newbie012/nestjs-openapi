    "/params/{imageBuildId}": {
      "get": {
        "operationId": "ParamsController_get",
        "parameters": [
          {
            "description": "Image build id",
            "in": "path",
            "name": "imageBuildId",
            "required": true,
            "schema": {
              "example": "build-1",
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Max items",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "example": 50,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "enum": [
                "low",
                "high"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "levels",
            "required": true,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/Priority"
              },
              "type": "array"
            }
          },
          {
            "allowEmptyValue": true,
            "deprecated": true,
            "explode": false,
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            "style": "form"
          },
          {
            "examples": {
              "one": {
                "value": {
                  "a": "x"
                }
              }
            },
            "in": "query",
            "name": "filter",
            "required": false,
            "schema": {
              "properties": {
                "a": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          {
            "description": "Free text search",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "example": "nginx",
              "type": "string"
            }
          },
          {
            "description": "Request id",
            "in": "header",
            "name": "x-request-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-trace",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Workspace id",
            "in": "header",
            "name": "x-workspace",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "Params"
        ]
      }
    },
    "/params": {
      "get": {
        "operationId": "ParamsController_page",
        "parameters": [
          {
            "description": "Page size",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "example": 20,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Sort field",
            "in": "query",
            "name": "sortBy",
            "required": true,
            "schema": {
              "enum": [
                "name",
                "createdAt"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "required": false,
            "schema": {
              "example": "red,blue",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "colors",
            "required": false,
            "schema": {
              "examples": [
                "red",
                "blue"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "bornSince",
            "required": false,
            "schema": {
              "example": "2024-01-01",
              "examples": [
                "2024-01-01",
                "2024-02-01"
              ],
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Workspace id",
            "in": "header",
            "name": "x-workspace",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "Params"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ReportDto": {
        "properties": {
          "format": {
            "type": "string"
          }
        },
        "required": [
          "format"
        ],
        "type": "object"
      },
      "CreateItemDto": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ItemDto": {
        "properties": {
          "id": {
            "description": "Item id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "ErrorDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "SearchDto": {
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/FilterDto"
          },
          "otherFilter": {
            "$ref": "#/components/schemas/OtherFilterDto"
          },
          "text": {
            "description": "Free text",
            "type": "string"
          },
          "page": {
            "type": "number"
          },
          "plain": {
            "$ref": "#/components/schemas/FilterDto"
          }
        },
        "type": "object"
      },
      "FilterDto": {
        "properties": {
          "field": {
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "type": "object"
      },
      "OtherFilterDto": {
        "properties": {
          "other": {
            "type": "string"
          }
        },
        "required": [
          "other"
        ],
        "type": "object"
      },
      "ExternalLibraryDto": {
        "properties": {
          "name": {
            "description": "Library name",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "LibraryUsageDto": {
        "properties": {
          "ref": {
            "$ref": "#/components/schemas/ExternalLibraryRefDto",
            "description": "The library reference"
          },
          "previous": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExternalLibraryRefDto"
              },
              {
                "type": "null"
              }
            ],
            "description": "Previous reference"
          },
          "history": {
            "description": "All references",
            "items": {
              "$ref": "#/components/schemas/ExternalLibraryRefDto"
            },
            "type": "array"
          }
        },
        "required": [
          "ref",
          "previous",
          "history"
        ],
        "type": "object"
      },
      "ExternalLibraryRefDto": {
        "properties": {
          "source": {
            "description": "Where it came from",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PropertyOptionsDto": {
        "properties": {
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "payload": {
            "$ref": "#/components/schemas/DecoratorOnlyDto"
          },
          "payloads": {
            "items": {
              "$ref": "#/components/schemas/DecoratorOnlyDto"
            },
            "type": "array"
          },
          "rating": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "numericString": {
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "pattern": "^[a-f0-9-]+$",
            "type": "string"
          },
          "name": {
            "default": "anonymous",
            "example": "Ada",
            "maxLength": 40,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "legacyId": {
            "deprecated": true,
            "readOnly": true,
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "pet": {
            "discriminator": {
              "mapping": {
                "cat": "#/components/schemas/CatDto",
                "dog": "#/components/schemas/DogDto"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/CatDto"
              },
              {
                "$ref": "#/components/schemas/DogDto"
              }
            ]
          },
          "keyedPet": {
            "discriminator": {
              "mapping": {
                "cat": "#/components/schemas/CatDto",
                "dog": "#/components/schemas/DogDto"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/CatDto"
              },
              {
                "$ref": "#/components/schemas/DogDto"
              }
            ]
          },
          "tagList": {
            "description": "Comma-separated tags",
            "type": "string"
          },
          "previousAddress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Address"
              },
              {
                "type": "null"
              }
            ],
            "description": "The previous address"
          },
          "billingAddress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Address"
              },
              {
                "type": "null"
              }
            ]
          },
          "fallbackPriority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Priority"
              },
              {
                "type": "null"
              }
            ]
          },
          "addressOrLabel": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Address"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "emails": {
            "items": {
              "format": "email",
              "type": "string"
            },
            "type": "array"
          },
          "maybe": {
            "description": "Maybe a number",
            "type": [
              "number",
              "null"
            ]
          },
          "sample": {
            "examples": [
              "a",
              "b"
            ],
            "type": "string"
          },
          "priority": {
            "enum": [
              "low",
              "high"
            ],
            "type": "string"
          },
          "priorities": {
            "items": {
              "$ref": "#/components/schemas/Priority"
            },
            "type": "array"
          },
          "level": {
            "enum": [
              1,
              2
            ],
            "type": "number"
          },
          "order": {
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "plainPriority": {
            "enum": [
              "low",
              "high"
            ],
            "type": "string"
          }
        },
        "required": [
          "address",
          "payload",
          "payloads",
          "rating",
          "numericString",
          "id",
          "name",
          "tags",
          "legacyId",
          "password",
          "labels",
          "pet",
          "keyedPet",
          "tagList",
          "previousAddress",
          "billingAddress",
          "fallbackPriority",
          "addressOrLabel",
          "emails",
          "maybe",
          "sample",
          "priority",
          "priorities",
          "level",
          "plainPriority"
        ],
        "type": "object"
      },
      "Address": {
        "properties": {
          "street": {
            "type": "string"
          }
        },
        "required": [
          "street"
        ],
        "type": "object"
      },
      "DecoratorOnlyDto": {
        "properties": {
          "value": {
            "description": "Only named by decorators",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "CatDto": {
        "properties": {
          "kind": {
            "enum": [
              "cat"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "DogDto": {
        "properties": {
          "kind": {
            "enum": [
              "dog"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "Priority": {
        "enum": [
          "low",
          "high"
        ],
        "type": "string"
      },
      "PersonListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PersonDto"
            },
            "type": "array"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
