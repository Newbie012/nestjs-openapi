{
  "openapi": "3.2.0",
  "info": {
    "description": "Tests @ApiProperty({ enum: ... }) extraction",
    "title": "ApiProperty Enum Test",
    "version": "1.0.0"
  },
  "servers": [],
  "paths": {
    "/items": {
      "get": {
        "operationId": "ItemController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of items"
          }
        },
        "summary": "Get all items",
        "tags": [
          "Items"
        ]
      },
      "post": {
        "operationId": "ItemController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            },
            "description": "Item created"
          }
        },
        "summary": "Create an item",
        "tags": [
          "Items"
        ]
      }
    },
    "/tasks": {
      "get": {
        "operationId": "TaskController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of tasks"
          }
        },
        "summary": "Get all tasks",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/tasks/search": {
      "post": {
        "operationId": "TaskController_search",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Search results"
          }
        },
        "summary": "Search tasks",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/tasks/filter": {
      "get": {
        "operationId": "TaskController_filter",
        "parameters": [
          {
            "in": "query",
            "name": "channel",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          {
            "in": "query",
            "name": "color",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Color"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Filtered tasks"
          }
        },
        "summary": "Filter tasks by enum-typed query params",
        "tags": [
          "Tasks"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ItemDto": {
        "description": "DTO covering all extractable",
        "properties": {
          "name": {
            "description": "Display name of the item",
            "type": "string"
          },
          "color": {
            "$ref": "#/components/schemas/Color",
            "description": "Item color"
          },
          "status": {
            "description": "Item status",
            "enum": [
              "active",
              "deprecated",
              "archived"
            ],
            "type": "string"
          },
          "email": {
            "description": "Contact email",
            "format": "email",
            "type": "string"
          },
          "price": {
            "description": "Item price",
            "maximum": 10000,
            "minimum": 0,
            "type": "number"
          },
          "slug": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "currency": {
            "default": "USD",
            "example": "USD",
            "type": "string"
          },
          "legacyCode": {
            "deprecated": true,
            "description": "Use slug instead",
            "type": "string"
          },
          "id": {
            "readOnly": true,
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "description": "Searchable tags",
            "items": {
              "type": "string"
            },
            "title": "Tag List",
            "type": "array"
          },
          "codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "weight": {
            "multipleOf": 0.01,
            "type": "number"
          },
          "ratio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "sku": {
            "pattern": "^[A-Z]{2}-\\d+$",
            "type": "string"
          },
          "variants": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "name",
          "color",
          "status",
          "email",
          "price",
          "slug",
          "currency",
          "legacyCode",
          "id",
          "password",
          "notes",
          "tags",
          "codes",
          "weight",
          "ratio",
          "sku",
          "variants"
        ],
        "type": "object"
      },
      "Color": {
        "description": "Enums defined in a separate file (simulates enums from external packages)",
        "enum": [
          "red",
          "green",
          "blue",
          "yellow"
        ],
        "type": "string"
      },
      "TaskDto": {
        "properties": {
          "title": {
            "description": "Task title",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority",
            "description": "Task priority"
          },
          "estimate": {
            "$ref": "#/components/schemas/Size",
            "description": "T-shirt size estimate"
          }
        },
        "required": [
          "title",
          "priority"
        ],
        "type": "object"
      },
      "Priority": {
        "enum": [
          0,
          1,
          2,
          3,
          4
        ],
        "type": "number"
      },
      "Size": {
        "enum": [
          "S",
          "M",
          "L",
          "XL"
        ],
        "type": "string"
      },
      "SearchDto": {
        "properties": {
          "sortOrder": {
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "sizes": {
            "description": "Filter by sizes",
            "items": {
              "$ref": "#/components/schemas/Size"
            },
            "type": "array"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel",
            "description": "Delivery channel"
          },
          "fallbackChannel": {
            "$ref": "#/components/schemas/Channel"
          }
        },
        "required": [
          "sortOrder",
          "sizes",
          "channel",
          "fallbackChannel"
        ],
        "type": "object"
      },
      "Channel": {
        "const": "email",
        "description": "Single-member enum: TypeScript collapses its declared type to the member literal, so schema naming must walk back up to the enum declaration.",
        "type": "string"
      }
    }
  },
  "tags": []
}
