        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActiveFiltersDto": {
        "properties": {
          "priorityLevels": {
            "items": {
              "$ref": "#/components/schemas/FilterOption_PriorityLevelDto"
            },
            "type": "array"
          }
        },
        "required": [
          "priorityLevels"
        ],
        "type": "object"
      },
      "ChannelUnavailableReason": {
        "enum": [
          "not_configured",
          "no_permission"
        ],
        "type": "string"
      },
      "DateRangeOptions": {
        "properties": {
          "days": {
            "type": "number"
          }
        },
        "required": [
          "days"
        ],
        "type": "object"
      },
      "FilterOption_DateRangeOptions": {
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/DateRangeOptions"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "type": "object"
      },
      "FilterOption_PriorityLevelDto": {
        "properties": {
          "count": {
            "type": "number"
          },
          "option": {
            "$ref": "#/components/schemas/PriorityLevelDto"
          }
        },
        "required": [
          "option",
          "count"
        ],
        "type": "object"
      },
      "NotificationChannel": {
        "enum": [
          "email",
          "sms",
          "push"
        ],
        "type": "string"
      },
      "NotificationSettingsDto": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/NotificationChannel"
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/NotificationChannel"
            },
            "type": "array"
          },
          "label": {
            "enum": [
              "email",
              "sms",
              "push"
            ],
            "type": "string"
          },
          "unavailableReason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChannelUnavailableReason"
              }
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "channel",
          "channels",
          "label"
        ],
        "type": "object"
      },
      "Owner": {
        "properties": {
          "id": {
            "type": "string"
          },
          "pet": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Pet"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "id",
          "pet",
          "profile"
        ],
        "type": "object"
      },
      "PatchNoteDto": {
        "properties": {
          "archived": {
            "nullable": true,
            "type": "boolean"
          },
          "reason": {
            "maxLength": 250,
            "nullable": true,
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "summary"
        ],
        "type": "object"
      },
      "Pet": {
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        },
        "required": [
          "id",
          "owner"
        ],
        "type": "object"
      },
      "PriorityLevelDto": {
        "properties": {
          "level": {
            "type": "string"
          }
        },
        "required": [
          "level"
        ],
        "type": "object"
      },
      "Profile": {
        "properties": {
          "bio": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        },
        "required": [
          "bio",
          "owner"
        ],
        "type": "object"
      },
      "SearchFiltersDto": {
        "properties": {
          "dateRange": {
            "$ref": "#/components/schemas/FilterOption_DateRangeOptions"
          }
        },
        "required": [
          "dateRange"
        ],
        "type": "object"
      },
      "ThemeMode": {
        "enum": [
          "light",
          "dark",
          "system"
        ],
        "type": "string"
      },
      "UpdateThemeDto": {
        "properties": {
          "themeMode": {
            "$ref": "#/components/schemas/ThemeMode"
          }
        },
        "required": [
          "themeMode"
        ],
        "type": "object"
      },
      "UserProfile": {
        "properties": {
          "address": {
            "additionalProperties": {},
            "properties": {
              "country": {
                "type": "string"
              },
              "formatted": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "groups": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sub": {
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "groups",
          "sub"
        ],
        "type": "object"
      }
    }
  },
  "tags": []
}
