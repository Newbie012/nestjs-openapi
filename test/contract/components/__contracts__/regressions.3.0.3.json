          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchNoteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatchNoteDto"
                }
              }
            },
            "description": ""
          }
        },
